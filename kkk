        const rawAria = btnEl.getAttribute('aria-label');
        if (rawAria && !rawAria.includes('[object Object]') && !rawAria.toLowerCase().includes('object object')) {
            const cleanAria = rawAria.replace(/\s+/g, ' ').trim();
            if (cleanAria) return cleanAria;
        }

        // 2. Check visible innerText or textContent (e.g. Forgot User ID, Forgot Password, Register)
        const rawText = btnEl.innerText || btnEl.textContent || '';
        const cleanText = rawText.replace(/\s+/g, ' ').trim();
        if (cleanText) return cleanText;

        // 3. Check title attribute
        const titleAttr = btnEl.getAttribute('title');
        if (titleAttr && titleAttr.trim()) return titleAttr.trim();

        // 4. Check nested SVG title or alt attribute
        const svgAlt = btnEl.querySelector('svg')?.getAttribute('aria-label') || btnEl.querySelector('img')?.getAttribute('alt');
        if (svgAlt && svgAlt.trim()) return svgAlt.trim();

        // 5. Intelligent Fallback for Icon-only Social Media and Store Links (e.g. Google Play, App Store, X, Facebook, Instagram)
        const href = (btnEl.getAttribute('href') || '').toLowerCase();
        const className = (btnEl.className || '').toString().toLowerCase();

        if (className.includes('twitter') || href.includes('twitter.com') || href.includes('x.com')) return 'X';
        if (className.includes('facebook') || href.includes('facebook.com')) return 'Facebook';
        if (className.includes('insta') || href.includes('instagram.com')) return 'Instagram';
        if (className.includes('playstore') || className.includes('googleplay') || href.includes('play.google.com')) return 'Google Play';
        if (className.includes('apple') || href.includes('apple.com')) return 'App Store';
        if (className.includes('youtube') || href.includes('youtube.com')) return 'YouTube';
        if (className.includes('linkedin') || href.includes('linkedin.com')) return 'LinkedIn';

        return '';
    }

