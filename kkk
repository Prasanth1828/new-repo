    }

    function saveSettings() {
        const settings = {
            screenReader: screenReader,
            fontSizeCount: Math.max(0, fontSizeCount > 0 ? fontSizeCount - 1 : 0),
            lineHeightCount: Math.max(0, lineHeightCount > 0 ? lineHeightCount - 1 : 0),
