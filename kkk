    function applyTextSettings() {
        const targetZoom = ZOOM_LEVELS[fontSizeCount] !== undefined ? ZOOM_LEVELS[fontSizeCount] : 1;
        let style = document.getElementById(ZOOM_STYLE_ID);

        if (targetZoom === 1) {
            if (style) style.remove();
            // Remove the --app-zoom CSS variable when zoom returns to normal
            document.documentElement.style.removeProperty('--app-zoom');
            // Reset any residual browser window scroll offset
            window.scrollTo(0, 0);
            document.querySelectorAll('body > *:not(.uwaw), .MuiDialog-paper, .mui-dialog').forEach(el => {
                if (el.style.zoom) el.style.zoom = '';
