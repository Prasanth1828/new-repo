  background-color: #ECD0FF;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all 1s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 12px;
  color: var(--color-black4);
  font-size: 14px;
  transition: all 300ms;
  width: 100%;
  font-weight: 500;
}

.btn-reset-all img {
  height: 30px;
  filter: brightness(0) invert(1);

}

