  background: #444701 !important;
  color: yellow !important;
  outline: 2px solid yellow !important;
}

/* Accessibility: Ensure typography and SVG icons inside actual external application links turn yellow */
.ux4g-accessibility-highlight-links a[href^="http://"]:not(#uw-main a) *,
