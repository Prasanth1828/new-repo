            document.documentElement.style.setProperty('--app-zoom', targetZoom);
            // Reset window scroll to ensure fixed headers and top content remain properly aligned
            window.scrollTo(0, 0);
            if (!style) {
                style = document.createElement('style');
                style.id = ZOOM_STYLE_ID;
                document.head.appendChild(style);
            }
            style.textContent = `
                :root {
                    --app-zoom: ${targetZoom};
                }
                #root,
                body > *:not(.uwaw):not(.MuiDialog-root):not(.MuiModal-root):not(.MuiPopover-root):not(#${ZOOM_STYLE_ID}) {
